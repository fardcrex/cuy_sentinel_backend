FROM ubuntu:22.04

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends snmpd && \
    rm -rf /var/lib/apt/lists/*

# Minimal config: allow read with community "public", expose all MIBs
RUN printf '\
rocommunity public\n\
sysLocation  Docker Mock\n\
sysContact   ops@cuy-sentinel\n\
agentAddress udp:161\n\
view systemonly included .1\n\
' > /etc/snmp/snmpd.conf

EXPOSE 161/udp

CMD ["snmpd", "-f", "-Lo", "-c", "/etc/snmp/snmpd.conf"]
